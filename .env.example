# Salin ke .env.local lalu isi. .env.local tidak ikut git (lihat .gitignore).

# ── Database dev ────────────────────────────────────────────────────────────
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=devuser
DATABASE_PASSWORD=
DATABASE_NAME=pupr_dev

# ── API eNominasi (karir.pu.go.id/enom) — sumber Penilaian Kinerja & Potkom ──
# Dipakai lib/enom. WAJIB dari env: contoh yang beredar (enom_api_bikon.php)
# menuliskan kuncinya langsung di kode — jangan diikuti, kunci di dalam kode
# ikut ke mana pun kodenya pergi.
#
# Setiap panggilan TERCATAT di sisi eNom (balasannya memuat infoip & waktu_ambil),
# jadi pengujian bervolume perlu sepengetahuan pengelolanya.
ENOM_SECRET=
# Opsional — sudah ada bawaannya di lib/enom/klien.ts:
#ENOM_URL=https://karir.pu.go.id/enom/api/cekdata_bikon
#ENOM_TIMEOUT_MS=30000
#ENOM_BATCH=50

# Batasi tampilan frontend ke pegawai yang ADA di API eNominasi saja.
# Saklar eksperimen dev: DB tidak diubah, hanya kueri baca yang disaring.
# Definisinya satu tempat: filterSumber() di lib/kueri/dasar.ts
#HANYA_PEGAWAI_SUMBER=true
