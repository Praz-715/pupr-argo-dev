{
  "name": "simt-djbk",
  "version": "0.1.0",
  "private": true,
  "description": "SIMT DJBK — Sistem Informasi Manajemen Talenta, Direktorat Jenderal Bina Konstruksi",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node e2e/fase-0.smoke.mjs .next/smoke && node e2e/fase-1.smoke.mjs .next/smoke && node e2e/fase-2.smoke.mjs .next/smoke && node e2e/fase-3.smoke.mjs .next/smoke && node e2e/fase-4.smoke.mjs .next/smoke && node e2e/fase-5.smoke.mjs .next/smoke && node e2e/fase-6.smoke.mjs .next/smoke && node e2e/fase-7.smoke.mjs .next/smoke && node e2e/fase-8.smoke.mjs .next/smoke && node e2e/fase-9.smoke.mjs .next/smoke && node e2e/fase-10.smoke.mjs .next/smoke",
    "db:sql": "tsx scripts/jalankan-sql.ts",
    "verifikasi": "npm run typecheck && npm run lint && npm run test",
    "verifikasi:data": "tsx scripts/verifikasi-data.ts",
    "ukur:kueri": "tsx --conditions react-server scripts/ukur-kueri.ts",
    "db:volume": "tsx scripts/seed-volume.ts",
    "ukur:kueri:volume": "tsx --conditions react-server scripts/ukur-kueri.ts --volume",
    "db:pull": "drizzle-kit pull",
    "db:gen-seed": "tsx scripts/gen-006-seed-perluasan.ts",
    "db:recompute": "tsx --conditions react-server scripts/recompute.ts",
    "ukur:payload": "tsx --conditions react-server scripts/ukur-payload.ts",
    "ukur:payload:volume": "tsx --conditions react-server scripts/ukur-payload.ts --volume",
    "db:gen-risiko": "tsx scripts/gen-008-seed-risiko.ts",
    "verifikasi:skoring": "tsx --conditions react-server scripts/verifikasi-skoring.ts",
    "ukur:hitung-ulang": "tsx --conditions react-server scripts/ukur-hitung-ulang.ts",
    "ukur:hitung-ulang:volume": "tsx --conditions react-server scripts/ukur-hitung-ulang.ts --volume",
    "ukur:hitung-ulang:volume:semua": "tsx --conditions react-server scripts/ukur-hitung-ulang.ts --volume --semua",
    "db:gen-token-api": "tsx scripts/gen-013-token-api.ts",
    "ukur:dampak-skoring": "tsx --conditions react-server scripts/ukur-dampak-tahap2.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "mysql2": "^3.23.2",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
